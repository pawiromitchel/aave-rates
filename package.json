{
  "name": "aave-rates",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "serve": "concurrently \"npx tailwindcss -i ./input.css -o ./views/public/output.css --watch\" \"node --env-file=.env server.js\"",
    "build": "npm run build:css && npm run build:js",
    "build:css": "npx tailwindcss -i ./input.css -o ./views/public/output.css --minify",
    "build:js": "esbuild views/public/app.js --bundle --format=esm --outfile=views/public/app.bundle.js --platform=browser"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawiromitchel/aave-rates.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pawiromitchel/aave-rates/issues"
  },
  "homepage": "https://github.com/pawiromitchel/aave-rates#readme",
  "description": "",
  "dependencies": {
    "@aave/contract-helpers": "^1.30.5",
    "@aave/math-utils": "^1.30.5",
    "@bgd-labs/aave-address-book": "^4.7.0",
    "@fastify/static": "^8.0.3",
    "concurrently": "^9.1.2",
    "ethers": "^5.7.2",
    "fastify": "^5.2.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "daisyui": "^4.12.23",
    "esbuild": "^0.27.2",
    "tailwindcss": "^3.4.17"
  }
}
